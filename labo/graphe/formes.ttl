# Formes SHACL du graphe de recherche : douze règles de base (R0 à R11), la règle des suspensions (R12) et les règles des décisions et de la lignée (R13 à R18).
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix lab:     <https://labo.invalid/ns#> .
@prefix labsh:   <https://labo.invalid/formes#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mls:     <http://www.w3.org/ns/mls#> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .

labsh: sh:declare
    [ sh:prefix "lab" ;     sh:namespace "https://labo.invalid/ns#"^^xsd:anyURI ] ,
    [ sh:prefix "rdfs" ;    sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
    [ sh:prefix "prov" ;    sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
    [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
    [ sh:prefix "mls" ;     sh:namespace "http://www.w3.org/ns/mls#"^^xsd:anyURI ] .

# R0 — une empreinte est un SHA-256 en hexadécimal minuscule
labsh:Empreinte a sh:NodeShape ;
    sh:property [ sh:path spdx:algorithm ; sh:hasValue spdx:checksumAlgorithm_sha256 ] ;
    sh:property [ sh:path spdx:checksumValue ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

# R1 — toute idée a un identifiant et une source (article, ou lab:interne)
labsh:Idee a sh:NodeShape ; sh:targetClass lab:Idee ;
    sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcterms:source ; sh:minCount 1 ;
                  sh:message "Idée sans source : citer l'article, ou dcterms:source lab:interne." ] .

# R2 — une hypothèse vient d'une idée, nomme sa mesure et son effet minimal d'intérêt
labsh:Hypothese a sh:NodeShape ; sh:targetClass lab:Hypothese ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:class lab:Idee ; sh:minCount 1 ] ;
    sh:property [ sh:path dcterms:description ; sh:minCount 1 ] ;
    sh:property [ sh:path mls:specifiedBy ; sh:minCount 1 ] ;
    sh:property [ sh:path lab:effetMinimal ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "Hypothèse sans effet minimal d'intérêt : elle ne peut pas être déclarée non soutenue." ] .

# R3 — une course a une clé, un état, une carte de calcul hachée
labsh:Course a sh:NodeShape ; sh:targetClass lab:Course ;
    sh:property [ sh:path lab:cle ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path lab:etat ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( lab:REUSSIE lab:ECHOUEE lab:ECHOUEE_ARTEFACTS lab:INCONNUE ) ] ;
    sh:property [ sh:path ( prov:qualifiedAssociation prov:hadPlan ) ; sh:minCount 1 ;
                  sh:class lab:CarteCalcul ] .

labsh:CarteCalcul a sh:NodeShape ; sh:targetClass lab:CarteCalcul , lab:CarteRecherche ;
    sh:property [ sh:path spdx:checksum ; sh:minCount 1 ; sh:node labsh:Empreinte ] ;
    sh:property [ sh:path dcterms:created ; sh:minCount 1 ; sh:datatype xsd:dateTime ] .

# R4 — pas de résultat sans artefact haché produit par une course réussie
labsh:Resultat a sh:NodeShape ; sh:targetClass lab:Resultat ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ;
                  sh:qualifiedValueShape [
                      sh:property [ sh:path spdx:checksum ; sh:minCount 1 ; sh:node labsh:Empreinte ] ;
                      sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class lab:Course ] ] ;
                  sh:qualifiedMinCount 1 ;
                  sh:message "Résultat sans artefact haché issu d'une course." ] ;
    sh:property [ sh:path ( prov:wasDerivedFrom prov:wasGeneratedBy lab:etat ) ;
                  sh:hasValue lab:REUSSIE ;
                  sh:message "Résultat tiré d'une course qui n'est pas REUSSIE." ] ;
    sh:property [ sh:path mls:hasValue ; sh:minCount 1 ; sh:maxCount 1 ] .

# R5 — un verdict a exactement un statut ; hors « non testée » et « suspendue », il a un fondement et des conditions
labsh:Verdict a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:property [ sh:path lab:portesur ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lab:Hypothese ] ;
    sh:property [ sh:path lab:fondeSur ; sh:or ( [ sh:class lab:Resultat ] [ sh:class lab:Course ] ) ;
                  sh:message "Un verdict se fonde sur un résultat ou une course du graphe, pas sur un nœud inconnu." ] ;
    sh:property [ sh:path lab:statut ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( lab:NonTestee lab:TestInvalide lab:NonConcluante lab:RefuteeIci lab:Soutenue lab:Suspendue ) ] ;
    sh:or (
        [ sh:path lab:statut ; sh:hasValue lab:NonTestee ]
        [ sh:path lab:statut ; sh:hasValue lab:Suspendue ]
        [ sh:and (
            [ sh:path lab:statut ; sh:hasValue lab:TestInvalide ]
            [ sh:path lab:motifInvalidite ; sh:minCount 1 ]
            [ sh:path prov:wasAttributedTo ; sh:minCount 1 ] ) ]
        [ sh:and (
            [ sh:path lab:fondeSur ; sh:minCount 1 ]
            [ sh:path lab:conditions ; sh:minCount 1 ]
            [ sh:path prov:wasAttributedTo ; sh:minCount 1 ] ) ] ) ;
    sh:message "Verdict testé sans fondement, sans conditions ou sans auteur." .

# R6 — « réfutée dans ces conditions » exige : carte confirmatoire, prémisse vérifiée,
#      puissance recalculée ≥ 0,8, et un IC dont la borne haute est sous l'effet minimal d'intérêt
labsh:Refutation a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "« Réfutée dans ces conditions » sans puissance ≥ 0,8, sans prémisse vérifiée, ou avec un IC qui n'exclut pas l'effet minimal : déclarer « non concluante »." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:statut lab:RefuteeIci ; lab:portesur ?h .
          FILTER NOT EXISTS {
            $this lab:fondeSur ?res .
            ?res prov:wasDerivedFrom/prov:wasGeneratedBy ?course ; lab:icHaut ?haut .
            ?course prov:qualifiedAssociation/prov:hadPlan/lab:carteRecherche ?cr .
            ?cr lab:teste ?h ; lab:puissance ?p ; lab:exploratoire false ;
                lab:premisse/lab:etatPremisse lab:verifiee .
            ?h lab:effetMinimal ?m .
            FILTER (?p >= 0.8 && ?haut < ?m)
          }
        }""" ] .

# R7 — « soutenue » exige une carte confirmatoire sur cette hypothèse et une borne basse > 0
labsh:Soutien a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "« Soutenue » sans carte confirmatoire sur cette hypothèse, ou borne basse ≤ 0." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:statut lab:Soutenue ; lab:portesur ?h .
          FILTER NOT EXISTS {
            $this lab:fondeSur ?res .
            ?res prov:wasDerivedFrom/prov:wasGeneratedBy/prov:qualifiedAssociation/prov:hadPlan/lab:carteRecherche ?cr ;
                 lab:icBas ?bas .
            ?cr lab:teste ?h ; lab:exploratoire false .
            FILTER (?bas > 0)
          }
        }""" ] .

# R8 — « test invalide » renvoie à une course échouée, ou dit en clair pourquoi le test est invalide
labsh:Invalide a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "« Test invalide » sans course ECHOUEE ou ECHOUEE_ARTEFACTS, ni lab:motifInvalidite." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:statut lab:TestInvalide .
          FILTER NOT EXISTS { $this lab:motifInvalidite ?m }
          FILTER NOT EXISTS { $this lab:fondeSur ?c . ?c a lab:Course ;
                              lab:etat ?e . FILTER (?e IN (lab:ECHOUEE, lab:ECHOUEE_ARTEFACTS)) }
        }""" ] .

# R9 — préinscription : la carte de recherche est datée AVANT le début de la course
labsh:Preinscription a sh:NodeShape ; sh:targetClass lab:Course ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Carte de recherche datée après le début de la course : ce n'est pas une préinscription." ;
        sh:select """
        SELECT $this WHERE {
          $this prov:startedAtTime ?debut ;
                prov:qualifiedAssociation/prov:hadPlan/lab:carteRecherche/dcterms:created ?ecrite .
          FILTER (?ecrite > ?debut)
        }""" ] .

# R10 — une décision s'appuie sur au moins un verdict, une idée, un résultat ou une autre décision, et a un auteur
labsh:Decision a sh:NodeShape ; sh:targetClass lab:Decision ;
    sh:property [ sh:path lab:fondeSur ; sh:minCount 1 ;
                  sh:or ( [ sh:class lab:Verdict ] [ sh:class lab:Idee ] [ sh:class lab:Resultat ] [ sh:class lab:Decision ] ) ;
                  sh:message "Décision sans fondement : un verdict, une idée, un résultat ou une autre décision du graphe." ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:generatedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path lab:regle ; sh:minCount 1 ] ;
    sh:property [ sh:path lab:importance ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "courante" "importante" ) ] ;
    sh:property [ sh:path lab:etatDecision ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( "proposee" "en_attente_humain" "relue" "executee" "notee" ) ] ;
    sh:property [ sh:path lab:poids ; sh:maxCount 1 ; sh:minInclusive 1 ; sh:maxInclusive 5 ] ;
    sh:property [ sh:path lab:effet ; sh:maxCount 1 ;
                  sh:in ( "ouvre_chantier" "ferme_chantier" "clot_piste" "production" "suite" "instrument" ) ] ;
    sh:property [ sh:path prov:wasRevisionOf ; sh:class lab:Decision ] .

# R13 — au moins deux options, dont « ne rien faire », chacune avec sa valeur V ; le choix est l'une d'elles
labsh:Options a sh:NodeShape ; sh:targetClass lab:Decision ;
    sh:property [ sh:path lab:option ; sh:minCount 2 ; sh:message "Décision avec moins de deux options." ] ;
    sh:property [ sh:path ( lab:option rdfs:label ) ; sh:hasValue "ne rien faire" ;
                  sh:message "Décision sans l'option « ne rien faire »." ] ;
    sh:property [ sh:path lab:choix ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Choix qui n'est pas l'une des options de la décision." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:choix ?c .
          FILTER NOT EXISTS { $this lab:option ?c }
        }""" ] .

labsh:OptionForme a sh:NodeShape ; sh:targetObjectsOf lab:option ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path lab:valeurV ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "Option sans valeur V estimée." ] .

# R14 — deux prédictions : l'issue attendue (un statut) avec sa probabilité, et la probabilité de changer une décision
labsh:Prediction a sh:NodeShape ; sh:targetClass lab:Decision ;
    sh:property [ sh:path lab:predictionIssue ; sh:maxCount 1 ;
                  sh:in ( lab:NonTestee lab:TestInvalide lab:NonConcluante lab:RefuteeIci lab:Soutenue lab:Suspendue ) ;
                  sh:message "Issue attendue hors des six statuts." ] ;
    sh:property [ sh:path lab:predictionBranche ; sh:maxCount 1 ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Décision sans issue attendue : un des six statuts, ou une branche du tableau issue → décision." ;
        sh:select """
        SELECT $this WHERE { FILTER (NOT EXISTS { $this lab:predictionIssue ?i } && NOT EXISTS { $this lab:predictionBranche ?b }) }""" ] ;
    sh:property [ sh:path lab:predictionProba ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ;
                  sh:message "Prédiction sans probabilité dans [0,1]." ] ;
    sh:property [ sh:path lab:predictionChangement ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ;
                  sh:message "Décision sans p_changement dans [0,1]." ] .

# R15 — une décision importante a une relecture datée et signée par un autre que l'auteur, et l'empreinte
#       du fichier de candidats dont les cinq premiers forment le dossier de relecture ;
#       exécutée, elle a été relue avant l'exécution
labsh:Relecture a sh:NodeShape ; sh:targetObjectsOf lab:relecture ;
    sh:property [ sh:path lab:verdictRelecture ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ] ;
    sh:property [ sh:path dcterms:created ; sh:minCount 1 ; sh:datatype xsd:dateTime ] .

labsh:ImportanteRelue a sh:NodeShape ; sh:targetClass lab:Decision ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Décision importante sans relecture." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:importance "importante" .
          FILTER NOT EXISTS { $this lab:relecture ?r }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Décision importante sans empreinte (SHA-256) du fichier de candidats du dossier de relecture." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:importance "importante" .
          FILTER NOT EXISTS { $this lab:empreinteCandidats ?e . FILTER regex(str(?e), "^[0-9a-f]{64}$") }
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Relecteur identique à l'auteur de la décision." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:relecture ?rel ; prov:wasAttributedTo ?a . ?rel prov:wasAttributedTo ?r .
          FILTER (?r = ?a)
        }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Décision importante exécutée sans relecture datée avant l'exécution." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:importance "importante" ; lab:etatDecision ?e . FILTER (?e IN ("executee", "notee"))
          FILTER NOT EXISTS { $this lab:relecture/dcterms:created ?d ; lab:dateExecution ?x . FILTER (?d <= ?x) }
        }""" ] .

# R16 — importance calculée : poids ≥ 4, effet ouvrant ou fermant un chantier, clôturant une piste ou de production,
#       statut réfuté ou suspendu proposé, plus de 3 h de calcul du chantier sur 24 h, ou verdict exploratoire
#       pour une mise en production. Une décision qui remplit une condition est importante.
labsh:ImportanceForcee a sh:NodeShape ; sh:targetClass lab:Decision ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Décision qui remplit une condition d'importance (poids ≥ 4, effet de chantier, de clôture ou de production, statut réfuté ou suspendu, > 3 h de calcul sur 24 h, verdict exploratoire pour la production) : elle est importante." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:importance "courante" .
          { $this lab:poids ?p . FILTER (?p >= 4) }
          UNION
          { $this lab:effet ?e . FILTER (?e IN ("ouvre_chantier", "ferme_chantier", "clot_piste", "production")) }
          UNION
          { $this lab:statutPropose ?s . FILTER (?s IN (lab:RefuteeIci, lab:Suspendue)) }
          UNION
          { $this lab:heuresCumulees24h ?h . FILTER (?h > 3) }
          UNION
          { $this lab:effet "production" ; lab:fondeSur ?v . ?v lab:fondeSur/prov:wasDerivedFrom/prov:wasGeneratedBy/prov:qualifiedAssociation/prov:hadPlan/lab:carteRecherche ?cr .
            ?cr lab:exploratoire true }
        }""" ] .

# R17 — une course ne s'appuie pas sur une carte confirmatoire dont une prémisse est non vérifiée
labsh:PremisseVerifiee a sh:NodeShape ; sh:targetClass lab:Course ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "Course rattachée à une carte confirmatoire dont une prémisse n'est pas vérifiée." ;
        sh:select """
        SELECT $this WHERE {
          $this prov:qualifiedAssociation/prov:hadPlan/lab:carteRecherche ?cr .
          ?cr lab:exploratoire false ; lab:premisse/lab:etatPremisse lab:non_verifiee .
          # Entrée en vigueur : les courses commencées ou finies avant la règle restent des constats, pas des violations.
          FILTER NOT EXISTS { $this prov:startedAtTime|prov:endedAtTime ?t .
                              FILTER (?t < "2026-11-18T17:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>) }
        }""" ] .

# R18 — lignée et données : une révision renvoie à une hypothèse ; les données d'un verdict sont des ressources
labsh:Lignee a sh:NodeShape ; sh:targetSubjectsOf prov:wasRevisionOf ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "prov:wasRevisionOf sur une hypothèse renvoie à autre chose qu'une hypothèse." ;
        sh:select """
        SELECT $this WHERE { $this a lab:Hypothese ; prov:wasRevisionOf ?o . FILTER NOT EXISTS { ?o a lab:Hypothese } }""" ] .

labsh:DonneesVerdict a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:property [ sh:path lab:donnees ; sh:nodeKind sh:IRI ] .

# R12 — « suspendue » dit à quelle condition on rouvre, et qui l'a décidé
labsh:Suspension a sh:NodeShape ; sh:targetClass lab:Verdict ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "« Suspendue » sans lab:reouvrirSi ni auteur." ;
        sh:select """
        SELECT $this WHERE {
          $this lab:statut lab:Suspendue .
          FILTER (NOT EXISTS { $this lab:reouvrirSi ?c } || NOT EXISTS { $this prov:wasAttributedTo ?a })
        }""" ] .

# R11 — les raccourcis refuteIci / soutient ne s'écrivent pas à la main : un verdict doit les porter
labsh:Raccourci a sh:NodeShape ; sh:targetSubjectsOf lab:refuteIci ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes labsh: ;
        sh:message "lab:refuteIci sans verdict « réfutée dans ces conditions » correspondant." ;
        sh:select """
        SELECT $this ?value WHERE {
          $this lab:refuteIci ?value .
          FILTER NOT EXISTS { ?v lab:fondeSur $this ; lab:portesur ?value ; lab:statut lab:RefuteeIci }
        }""" ] .
